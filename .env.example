# ==========================================
# HOKIMIYAT BOT - ENVIRONMENT CONFIGURATION
# ==========================================

# --- TELEGRAM BOT SETTINGS ---
# Telegram @BotFather orqali olingan token
BOT_TOKEN="7572941718:AAF9DxtXv5L5yGi9PQwcIM9B3EKiJ8cjfEk"

# Admin Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS="123456789,987654321"

# Majburiy a'zolik kanalları (@kanal_nomi yoki -1001234567890 ID formatida)
REQUIRED_CHANNELS="@hokimiyat_channel,-1001234567890,@survey_channel"

# Shifrlash kalit (16, 24 yoki 32 bayt uzunligi)
# Yangi kalit generatsiya qilish: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# --- DATABASE TYPE ---
# "postgresql" yoki "sqlite"
DB_TYPE="postgresql"

# --- PostgreSQL SETTINGS (DB_TYPE="postgresql" bo'lsa) ---
POSTGRES_DB="hokimiyat_db"
POSTGRES_USER="hokimiyat_user"
POSTGRES_PASSWORD="hokimiyat_pass_secure"
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"

# --- SQLite SETTINGS (DB_TYPE="sqlite" bo'lsa) ---
SQLITE_DB_NAME="hokimiyat_bot.db"

# --- REDIS SETTINGS ---
REDIS_HOST="redis"
REDIS_PORT="6379"
# REDIS_PASSWORD="sizning_redis_parolingiz"

# --- LOGGING SETTINGS (Optional) ---
LOG_LEVEL="INFO"
